# ============================================================
# telephony-service — environment variable reference
# Copy to .env for local dev; set each var in Railway dashboard
# for production. Never commit real secrets.
# ============================================================

# ── Service identity ─────────────────────────────────────────
SERVICE_NAME=telephony-service
# Railway injects PORT automatically; leave blank in Railway env vars.
PORT=3001
NODE_ENV=development

# ── Telnyx ──────────────────────────────────────────────────
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_API_BASE_URL=https://api.telnyx.com/v2
TELNYX_API_TIMEOUT_MS=8000
MAX_RETRIES=3
VOICE_LOOP_GREETING=Hello. Thanks for calling. How can I help you with your property search today?

# ── OpenAI / Whisper ASR ─────────────────────────────────────
# Set ASR_ENABLED=false to skip real Whisper calls (dev/CI)
ASR_ENABLED=false
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
ASR_TIMEOUT_MS=10000
ASR_MIN_CONFIDENCE=0.6

# ── ElevenLabs TTS ───────────────────────────────────────────
# Set TTS_ENABLED=false to skip real TTS calls (dev/CI)
TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_TIMEOUT_MS=10000

# ── Downstream services ──────────────────────────────────────
# Feature flags — enable each once the service is deployed
CONVERSATION_ENGINE_ENABLED=false
CONVERSATION_ENGINE_BASE_URL=http://localhost:3002
CONVERSATION_ENGINE_TIMEOUT_MS=2500

CRM_SERVICE_ENABLED=false
CRM_SERVICE_BASE_URL=http://localhost:3004
CRM_SERVICE_TIMEOUT_MS=2500

NLP_SERVICE_ENABLED=false
NLP_SERVICE_BASE_URL=http://localhost:3005
NLP_SERVICE_TIMEOUT_MS=2500

# ── Recovery queue ───────────────────────────────────────────
CRM_RECOVERY_QUEUE_ENABLED=true
# Enable file persistence only when a writable volume is mounted
CRM_RECOVERY_QUEUE_PERSIST_ENABLED=false
CRM_RECOVERY_QUEUE_FILE_PATH=./data/telephony-pending-leads.json
CRM_RECOVERY_QUEUE_TTL_HOURS=168

# ── Metrics emission ─────────────────────────────────────────
CRM_RECOVERY_METRICS_LOG_ENABLED=false
CRM_RECOVERY_METRICS_LOG_INTERVAL_MS=60000
