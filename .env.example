# ============================
# TELEPHONY (Telnyx)
# ============================
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
TELNYX_API_BASE_URL=https://api.telnyx.com/v2
TELNYX_API_TIMEOUT_MS=8000
VOICE_LOOP_GREETING=Hello. Thanks for calling. How can I help you with your property search today?

# ============================
# OPENAI (LLM + Whisper ASR)
# ============================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
ASR_ENABLED=true
ASR_TIMEOUT_MS=10000

# ============================
# ELEVENLABS (TTS)
# ============================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_ENABLED=true
TTS_TIMEOUT_MS=10000

# ============================
# GOOGLE CALENDAR API
# ============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ============================
# BACKEND CONFIG
# ============================
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ============================
# CRM (Google Sheets)
# ============================
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# ============================
# LOGGING
# ============================
LOG_LEVEL=info

# ============================
# RESILIENCE
# ============================
ASR_TIMEOUT_MS=10000
TTS_TIMEOUT_MS=10000
MAX_RETRIES=3
